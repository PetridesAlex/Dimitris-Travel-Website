{
  "name": "luxury-travel-cms",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise luxury travel website + custom CMS platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "lint": "npm run lint --workspace=web",
    "start": "npm run start --workspace=web",
    "seed:demo": "npx tsx apps/web/scripts/seed-from-demo.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
